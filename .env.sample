# GA4 Analytics Digest - Environment Variables
# Copy this file to .env and fill in your actual values

# Google Analytics 4 Configuration
# Your GA4 Property ID (just the number, e.g., "123456789")
GA4_PROPERTY_ID=your_ga4_property_id_here

# GA4 Service Account Credentials JSON
# Paste the entire contents of your service account JSON key file here
# You can get this from Google Cloud Console > IAM & Admin > Service Accounts
GA4_CREDENTIALS_JSON={"type":"service_account","project_id":"your-project","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"...","universe_domain":"googleapis.com"}

# Discord Webhook (active notification channel)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# Telegram Bot Configuration (inactive; retained for future use)
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Your Telegram Chat ID (get from @userinfobot, or use your channel/group ID)
TELEGRAM_CHAT_ID=your_chat_id_here
